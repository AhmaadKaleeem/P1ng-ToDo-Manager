{"nodes": [{"id": "$graphify-root$_agents_skills_hedgehog_src_skills_hedgehog_daily_skill_md", "label": "SKILL.md", "file_type": "document", "node_kind": "page", "source_file": ".agents/skills/hedgehog/src/skills/hedgehog-daily/SKILL.md", "source_location": "L1", "frontmatter": {"name": "hedgehog-daily", "description": "Use when a change request lands on a project that already has `.hedgehog/` and no build in flight \u2014 a finished build being adjusted, or an adopted repo&#x27;s next piece of work. Triggers on any &quot;change this&quot;, &quot;fix this&quot;, &quot;add this&quot; on such a project. Sizes the request against the installed core&#x27;s own layers and routes it to one of three exits: a tweak made and committed here, change-work through `hedgehog intent add` and the core&#x27;s loop, or a re-plan. Not for a build"}}, {"id": "$graphify-root$_agents_skills_hedgehog_src_skills_hedgehog_daily_skill_daily_change_work", "label": "Daily change-work", "file_type": "document", "node_kind": "heading", "source_file": ".agents/skills/hedgehog/src/skills/hedgehog-daily/SKILL.md", "source_location": "L6"}, {"id": "$graphify-root$_agents_skills_hedgehog_src_skills_hedgehog_daily_skill_entry", "label": "Entry", "file_type": "document", "node_kind": "heading", "source_file": ".agents/skills/hedgehog/src/skills/hedgehog-daily/SKILL.md", "source_location": "L17"}, {"id": "$graphify-root$_agents_skills_hedgehog_src_skills_hedgehog_daily_skill_the_three_exits", "label": "The three exits", "file_type": "document", "node_kind": "heading", "source_file": ".agents/skills/hedgehog/src/skills/hedgehog-daily/SKILL.md", "source_location": "L29"}, {"id": "$graphify-root$_agents_skills_hedgehog_src_skills_hedgehog_daily_skill_re_plan", "label": "Re-plan", "file_type": "document", "node_kind": "heading", "source_file": ".agents/skills/hedgehog/src/skills/hedgehog-daily/SKILL.md", "source_location": "L36"}, {"id": "$graphify-root$_agents_skills_hedgehog_src_skills_hedgehog_daily_skil